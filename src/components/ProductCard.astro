---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  price?: string;
  href: string;
  cta?: string;
  bullets?: string[];
}

const {
  eyebrow = 'DA field tool',
  title,
  description,
  price,
  href,
  cta = 'See the tool',
  bullets = [],
} = Astro.props;
---

<article class="product-card paper-surface torn-b" data-palette="field-notes">
  <span class="tape" aria-hidden="true"></span>
  <span class="tape tape--right" aria-hidden="true"></span>
  <div class="product-card__copy">
    <p class="product-card__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{description}</p>
    {bullets.length > 0 && (
      <ul>
        {bullets.map((bullet) => <li>{bullet}</li>)}
      </ul>
    )}
  </div>
  <div class="product-card__action">
    {price && <p class="product-card__price">{price}</p>}
    <a class="btn" href={href}>{cta} →</a>
    <p class="product-card__fine">Checkout happens on Etsy.</p>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    padding: clamp(1.8rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem) clamp(2.2rem, 5vw, 3.4rem);
    box-shadow: var(--shadow-card);
    transform: rotate(-0.6deg);
  }

  :global(.product-card + .product-card) { transform: rotate(0.5deg); }

  .product-card__eyebrow,
  .product-card__fine {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-card__eyebrow {
    color: var(--cyan-dark);
    font-weight: 700;
  }

  .product-card h2 {
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem);
    color: var(--ink);
  }

  .product-card ul {
    padding-left: 1.25rem;
    margin-bottom: 0;
  }

  .product-card li::marker {
    color: var(--pink-dark);
  }

  .product-card__action {
    min-width: 11rem;
    text-align: center;
  }

  .product-card__price {
    margin-bottom: var(--space-1);
    font-family: var(--font-headline);
    font-size: 3rem;
    line-height: 1;
    color: var(--ink);
  }

  .product-card .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--lime);
  }

  .product-card .btn:hover {
    background: transparent;
    color: var(--ink);
  }

  .product-card__fine {
    margin: 0.7rem 0 0;
  }

  @media (max-width: 42rem) {
    .product-card {
      grid-template-columns: 1fr;
      transform: none;
    }

    .product-card__action {
      text-align: left;
    }
  }
</style>
