---
// Spray-paint splatter, generated as a cluster of droplets + a few paint
// runs rather than hand-drawn bezier blobs — so it always reads as real
// splatter and never as a broken path. Rendered as inline SVG so it:
//   - recolors with the current text `color` (fill: currentColor); inside a
//     [data-palette] scope that means it follows the series accent;
//   - scales crisply at any size for almost no page weight;
//   - flips / rotates / fades purely from the caller's CSS.
//
// Usage:
//   <Splatter variant="burst" class="hero-splatter" />
//   <Splatter variant="drip" style="color: var(--accent-3)" />
//
// Every variant uses the same 0 0 200 200 viewBox so callers size them
// uniformly. `seed` is exposed for the rare case two adjacent splatters
// would otherwise be identical.

interface Props {
  variant?: 'burst' | 'blob' | 'drip' | 'fleck' | 'corner';
  seed?: number;
  class?: string;
  style?: string;
}

const {
  variant = 'burst',
  seed,
  class: className,
  style,
} = Astro.props;

// tiny deterministic PRNG (mulberry32) so a given (variant, seed) always
// draws the same splatter across builds
function rng(s: number) {
  return function () {
    s |= 0;
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Config = {
  seed: number;
  drops: number;
  spread: number; // how far droplets fling from center
  core: number; // radius of the central mass (0 = no core)
  runs: number; // number of paint drips
  runDown: boolean; // drips fall downward (else radial)
};

const CONFIGS: Record<NonNullable<Props['variant']>, Config> = {
  burst: { seed: 7, drops: 46, spread: 92, core: 26, runs: 3, runDown: false },
  blob: { seed: 21, drops: 28, spread: 60, core: 34, runs: 0, runDown: false },
  drip: { seed: 39, drops: 34, spread: 70, core: 24, runs: 5, runDown: true },
  fleck: { seed: 4, drops: 40, spread: 104, core: 0, runs: 0, runDown: false },
  corner: { seed: 58, drops: 38, spread: 120, core: 22, runs: 2, runDown: false },
};

const cfg = CONFIGS[variant];
const rand = rng(seed ?? cfg.seed);
const CX = 100;
const CY = 100;

const circles: { cx: number; cy: number; r: number }[] = [];
if (cfg.core > 0) circles.push({ cx: CX, cy: CY, r: cfg.core });

for (let i = 0; i < cfg.drops; i++) {
  // bias toward the center: distance = spread * rand^1.7
  const dist = cfg.spread * Math.pow(rand(), 1.7);
  const ang = rand() * Math.PI * 2;
  // radius: power law — mostly small flecks, a few fat blots
  const r = 1.1 + 13 * Math.pow(rand(), 3);
  circles.push({
    cx: CX + Math.cos(ang) * dist,
    cy: CY + Math.sin(ang) * dist,
    r,
  });
}

// paint runs: a thin capsule stretched away from center (or straight down)
const runs: { x: number; y: number; len: number; w: number; down: boolean }[] = [];
for (let i = 0; i < cfg.runs; i++) {
  const ang = cfg.runDown
    ? Math.PI / 2 + (rand() - 0.5) * 0.5
    : rand() * Math.PI * 2;
  const start = cfg.core > 0 ? cfg.core * 0.6 : 10 + rand() * 30;
  runs.push({
    x: CX + Math.cos(ang) * start,
    y: CY + Math.sin(ang) * start,
    len: 26 + rand() * 60,
    w: 2.4 + rand() * 4,
    down: cfg.runDown,
  });
}

const fmt = (n: number) => Math.round(n * 100) / 100;
---

<svg
  class:list={['splatter', className]}
  style={style}
  viewBox="0 0 200 200"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor">
    {
      runs.map((run) => {
        const ang = run.down ? Math.PI / 2 : Math.atan2(run.y - CY, run.x - CX);
        const ex = run.x + Math.cos(ang) * run.len;
        const ey = run.y + Math.sin(ang) * run.len;
        return (
          <>
            <line
              x1={fmt(run.x)}
              y1={fmt(run.y)}
              x2={fmt(ex)}
              y2={fmt(ey)}
              stroke="currentColor"
              stroke-width={fmt(run.w)}
              stroke-linecap="round"
            />
            <circle cx={fmt(ex)} cy={fmt(ey)} r={fmt(run.w * 0.9)} />
          </>
        );
      })
    }
    {circles.map((c) => <circle cx={fmt(c.cx)} cy={fmt(c.cy)} r={fmt(c.r)} />)}
  </g>
</svg>

<style>
  .splatter {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    /* real spray paint blooms a little at the edges */
    filter: drop-shadow(0 0 7px color-mix(in srgb, currentColor 38%, transparent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .splatter {
      animation: splat-in 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    }
  }

  @keyframes splat-in {
    from {
      transform: scale(0.74) rotate(-5deg);
      opacity: 0;
    }
  }
</style>
