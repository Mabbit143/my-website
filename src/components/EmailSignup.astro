---
// Newsletter provider: Kit (kit.com), confirmed 1 Sep 2026.
// Form ID / uid pulled from Lori's own Kit account embed code —
// this submits directly to her list, styled to match the site
// instead of Kit's default form design.
---

<div class="signup">
  <h2>Get the next one</h2>
  <p>No spam, no algorithm between us. Unsubscribe whenever.</p>
  <form
    action="https://app.kit.com/forms/9871140/subscriptions"
    class="signup-form"
    method="post"
    data-signup-form
  >
    <p class="signup-error" role="alert" data-signup-error></p>
    <div class="signup-fields">
      <label for="signup-email" class="visually-hidden">Email address</label>
      <input
        id="signup-email"
        type="email"
        name="email_address"
        placeholder="you@example.com"
        aria-label="Email Address"
        required
      />
      <button type="submit" class="btn">Join the list</button>
    </div>
  </form>
  <p class="signup-success" role="status" data-signup-success hidden>
    <strong>Whonah is sniffing out your inbox.</strong>
    Find our confirm link (try spam too) and click it to join the pack.
  </p>
</div>

<script>
  // Kit's own embed script (ck.5.js) ignored the form's success message and
  // showed a generic "thank you for signing up", so the form is submitted here
  // instead. Kit's endpoint doesn't send CORS headers, so the response can't be
  // read: success means the request went out, and Kit's double opt-in email
  // does the rest. Without JS the form still posts to Kit's hosted page.
  document.querySelectorAll<HTMLFormElement>('[data-signup-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-signup-error]');
    const success = form.parentElement?.querySelector<HTMLElement>('[data-signup-success]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (error) error.textContent = '';
      if (button) button.disabled = true;
      try {
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        form.hidden = true;
        if (success) success.hidden = false;
      } catch {
        if (error) error.textContent = "Couldn't sign you up. Check your connection and try again.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>

<style>
  .signup {
    /* was: border-top: 3px solid var(--da-black) — invisible against
       the now-dark page background, same fix as Header/Footer. */
    border-top: 3px solid var(--accent-1);
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-2);
    max-width: var(--content-max);
  }

  input[type='email'] {
    flex: 1 1 16rem;
    padding: 0.6em 0.8em;
    border: 2px solid var(--accent-1);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-family: var(--font-body);
    background: white;
    /* the input background is deliberately kept white for legibility
       and familiarity as a form field. Text color used to inherit
       --color-fg (dark ink on a light page, so it just worked); now
       --color-fg is light, so it needs to be pinned dark here or it
       would vanish against this white box. */
    color: var(--ink);
  }

  .signup-fields {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .signup-error {
    font-family: var(--font-typewriter);
    font-size: var(--step--1);
    color: var(--accent-1-strong);
    margin: 0;
  }

  .signup-error:empty {
    display: none;
  }

  .signup-success {
    margin: 0;
    padding: var(--space-2);
    border: 2px solid var(--accent-1);
    border-radius: var(--radius);
  }

  .signup-success strong {
    display: block;
  }
</style>
