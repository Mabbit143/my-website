---
// Newsletter provider is not yet chosen/approved (see SETUP_GUIDE.md,
// decision list item "newsletter provider"). This renders the module in
// place so the page layout is real, but the form does not submit anywhere
// yet — it's disabled and says so.
---

<div class="signup">
  <h2>Get the next one</h2>
  <p>No spam, no algorithm between us. Unsubscribe whenever.</p>
  <form aria-describedby="signup-note">
    <label for="signup-email" class="visually-hidden">Email address</label>
    <input id="signup-email" type="email" name="email" placeholder="you@example.com" disabled />
    <button type="submit" class="btn" disabled>Join the list</button>
  </form>
  <p id="signup-note" class="placeholder-note">
    <strong>Not connected yet.</strong> Pick a newsletter provider (Buttondown and Kit both have workable
    free tiers) and I'll wire this form up to it — 10 minute job once you decide.
  </p>
</div>

<style>
  .signup {
    border-top: 3px solid var(--da-black);
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-2);
    max-width: var(--content-max);
  }

  form {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  input[type='email'] {
    flex: 1 1 16rem;
    padding: 0.6em 0.8em;
    border: 2px solid var(--da-black);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-family: var(--font-body);
    background: white;
  }

  input:disabled,
  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
