---
// Newsletter provider: Kit (kit.com), confirmed 1 Sep 2026.
// Form ID / uid pulled from Lori's own Kit account embed code —
// this submits directly to her list, styled to match the site
// instead of Kit's default form design.
---

<div class="signup">
  <h2>Get the next one</h2>
  <p>No spam, no algorithm between us. Unsubscribe whenever.</p>
  <form
    action="https://app.kit.com/forms/9871140/subscriptions"
    class="seva-form formkit-form signup-form"
    method="post"
    data-sv-form="9871140"
    data-uid="adeeae6a0c"
    data-format="inline"
    data-version="5"
  >
    <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
    <div data-element="fields" data-stacked="false" class="signup-fields">
      <label for="signup-email" class="visually-hidden">Email address</label>
      <input
        id="signup-email"
        class="formkit-input"
        type="email"
        name="email_address"
        placeholder="you@example.com"
        aria-label="Email Address"
        required
      />
      <button type="submit" class="btn" data-element="submit">Join the list</button>
    </div>
  </form>
</div>

<script src="https://f.convertkit.com/ckjs/ck.5.js" is:inline async></script>

<style>
  .signup {
    border-top: 3px solid var(--da-black);
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-2);
    max-width: var(--content-max);
  }

  .signup-fields {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  input[type='email'] {
    flex: 1 1 16rem;
    padding: 0.6em 0.8em;
    border: 2px solid var(--da-black);
    border-radius: var(--radius);
    font-size: var(--step-0);
    font-family: var(--font-body);
    background: white;
  }

  .formkit-alert {
    font-family: var(--font-typewriter);
    font-size: var(--step--1);
    color: var(--accent-1-strong);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .formkit-alert:empty {
    display: none;
  }
</style>
