---
import Splatter from './Splatter.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer concrete">
  <span class="site-footer__splat" aria-hidden="true"><Splatter variant="burst" /></span>
  <div class="wrap site-footer__inner">
    <p class="line">Learn the rules. Question who wrote them.</p>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/articles/">Articles</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </nav>
    <p class="fine-print">&copy; {year} Deconstructing Academia. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* was: border-top: 3px solid var(--da-black) — that worked as a
       visible seam when the page above was light paper. Now the page
       above is also ink-colored, so the footer needs its own accent
       line to still read as a distinct section instead of just
       fading into the page. */
    border-top: 3px solid var(--accent-1);
    background: var(--da-black);
    color: var(--da-porcelain);
    margin-top: var(--space-6);
  }

  .site-footer__splat {
    position: absolute;
    left: -3rem;
    bottom: -4rem;
    width: 18rem;
    height: 18rem;
    color: var(--accent-1);
    opacity: 0.12;
    z-index: 0;
    pointer-events: none;
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .line {
    font-family: var(--font-headline);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--da-chartreuse);
    max-width: none;
  }

  .site-footer nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    color: var(--da-porcelain);
    text-decoration-color: var(--da-pink);
  }

  .fine-print {
    font-size: var(--step--1);
    opacity: 0.8;
    max-width: none;
  }
</style>
