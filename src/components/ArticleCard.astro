---
import { getSeries } from '../lib/series';

interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      deck: string;
      series: string;
      pubDate: Date;
      placeholder?: boolean;
      coverImage?: string;
    };
  };
  /** The lead story: a big Electric Violet scrap instead of a paper one. */
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const tilts = ['-1.1deg', '0.9deg', '-0.4deg', '1.3deg', '-0.8deg'];
const tilt = tilts[[...entry.slug].reduce((n, c) => n + c.charCodeAt(0), 0) % tilts.length];
const series = getSeries(entry.data.series);
const dateStr = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class:list={['card', featured ? 'card--featured' : 'paper-surface torn-b']} data-palette={series?.palette} style={`--tilt: ${tilt}`}>
  <span class="tape" aria-hidden="true"></span>
  {
    entry.data.coverImage && (
      <a class="card-graphic" href={`/articles/${entry.slug}/`} aria-hidden="true" tabindex="-1">
        <img src={entry.data.coverImage} alt="" loading="lazy" decoding="async" />
      </a>
    )
  }
  {series && <span class="pill">{series.name}</span>}
  <h3><a href={`/articles/${entry.slug}/`}>{entry.data.title}</a></h3>
  <p class="deck">{entry.data.deck}</p>
  <p class="meta">
    <time datetime={entry.data.pubDate.toISOString()}>{dateStr}</time>
    {entry.data.placeholder && <span class="tag-placeholder">sample content</span>}
    <a class="read" href={`/articles/${entry.slug}/`} aria-hidden="true" tabindex="-1">Read it →</a>
  </p>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    height: 100%;
    padding: 2rem 1.8rem 2.2rem;
    box-shadow: var(--shadow-card);
  }

  /* a desk full of clippings, not a spreadsheet — tilt set per slug */
  .card:not(.card--featured) { transform: rotate(var(--tilt, -0.6deg)); }

  .card--featured {
    background: var(--violet);
    color: var(--paper);
    padding: clamp(2rem, 4vw, 3.2rem);
    transform: rotate(-0.8deg);
  }

  .card-graphic {
    display: block;
    margin: -0.6rem -0.6rem 0.4rem;
    border: 2px solid var(--ink);
    text-decoration: none;
    background: var(--ink);
  }

  .card-graphic img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* chip: the palette's accent, readable ink text; violet gets paper text */
  .card .pill { align-self: flex-start; }
  .card:not(.card--featured)[data-palette='electric'] .pill { color: var(--paper); }
  .card--featured .pill { background: var(--lime); color: var(--ink); }

  .card h3 {
    margin: 0;
    font-family: var(--font-headline);
    font-weight: 400;
    font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .card--featured h3 {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.4rem);
    line-height: 0.98;
    max-width: 18ch;
  }

  .card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--pink-dark);
    text-decoration-thickness: 3px;
  }

  .card--featured h3 a:hover { text-decoration-color: var(--lime); }

  .deck {
    margin: 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .card--featured .deck { font-size: 1.15rem; }

  .meta {
    margin: auto 0 0;
    padding-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem var(--space-2);
    align-items: center;
    justify-content: space-between;
    max-width: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .read {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--cyan-dark);
    text-decoration: none;
  }

  .card--featured .read { color: var(--paper); }

  .tag-placeholder {
    font-family: var(--font-headline);
    color: var(--pink-dark);
  }

  .card--featured .tag-placeholder { color: var(--lime); }
</style>
