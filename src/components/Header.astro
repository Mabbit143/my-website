---

const nav = [
  { href: '/#start-here', label: 'Start here' },
  { href: '/articles/', label: 'Articles' },
  { href: '/shop/', label: 'Shop' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="wordmark" aria-label="Deconstructing Academia — home">
      <img class="wordmark__badge" src="/images/da-logo.png" alt="" width="320" height="320" />
      <span class="wordmark__text">Deconstructing Academia<span class="wordmark__tag">Critical academic literacy</span></span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ 'nav-shop': item.href === '/shop/' }}
                aria-current={item.href !== '/#start-here' && path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid rgb(245 242 234 / 14%);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: 0.9rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: var(--paper);
  }

  .wordmark__badge {
    width: 4rem;
    height: 4rem;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .wordmark__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-headline);
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .wordmark__tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--cyan-light);
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    align-items: center;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--paper);
    border-bottom: 3px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--lime);
  }

  nav a.nav-shop {
    min-height: 44px;
    padding: 0 0.9em;
    border: 2px solid var(--lime);
    color: var(--lime);
  }

  nav a.nav-shop:hover,
  nav a.nav-shop[aria-current='page'] {
    background: var(--lime);
    color: var(--ink);
  }

  @media (max-width: 46rem) {
    nav { width: 100%; }
    nav ul { gap: 0.25rem 1.1rem; }
    nav a { font-size: 0.82rem; }
  }

  @media (max-width: 40rem) {
    .wordmark__badge { width: 3rem; height: 3rem; }
    .wordmark__text { font-size: 1.15rem; }
  }
</style>
