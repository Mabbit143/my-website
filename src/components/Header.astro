---
import Splatter from './Splatter.astro';

const nav = [
  { href: '/#start-here', label: 'Start here' },
  { href: '/articles/', label: 'Articles' },
  { href: '/shop/', label: 'Shop' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header concrete">
  <span class="site-header__splat" aria-hidden="true"><Splatter variant="fleck" /></span>
  <div class="wrap site-header__inner">
    <a href="/" class="wordmark" aria-label="Deconstructing Academia — home">
      <span class="wordmark__portrait" aria-hidden="true">
        <img src="/images/characters/Mabbit-front-arms-crossed.png" alt="" width="1376" height="768" />
      </span>
      <span class="wordmark__text">Deconstructing<br /><span class="wordmark__accent">Academia</span></span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ 'nav-shop': item.href === '/shop/' }}
                aria-current={item.href !== '/#start-here' && path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* was: border-bottom: 3px solid var(--da-black) — invisible now that
       the page background is also ink-colored. A neon rule reads as an
       intentional line instead of a missing one. */
    border-bottom: 3px solid var(--accent-1);
    background: var(--color-bg);
  }

  .site-header__splat {
    position: absolute;
    right: -1.5rem;
    top: -2.5rem;
    width: 12rem;
    height: 12rem;
    color: var(--accent-1);
    opacity: 0.16;
    z-index: 0;
    pointer-events: none;
  }

  .site-header__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
  }

  .wordmark__portrait {
    position: relative;
    overflow: hidden;
    flex: 0 0 2.8rem;
    width: 2.8rem;
    height: 3.4rem;
    border: 2px solid var(--da-chartreuse);
    background: var(--ink);
  }

  .wordmark__portrait img {
    position: absolute;
    top: 0;
    left: -0.15rem;
    width: auto;
    max-width: none;
    height: 8.7rem;
  }

  .wordmark__text {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--color-fg);
  }

  .wordmark__accent {
    color: var(--da-pink);
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--color-fg);
    padding-bottom: 2px;
    border-bottom: 3px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--da-chartreuse);
  }

  nav a.nav-shop {
    padding: 0.45em 0.8em;
    border: 2px solid var(--da-chartreuse);
    color: var(--da-chartreuse);
  }

  nav a.nav-shop:hover,
  nav a.nav-shop[aria-current='page'] {
    background: var(--da-chartreuse);
    color: var(--ink);
  }

  @media (max-width: 46rem) {
    .site-header__inner {
      align-items: flex-start;
    }

    nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.35rem;
    }

    nav ul {
      width: max-content;
      flex-wrap: nowrap;
      gap: var(--space-2);
    }
  }

  @media (max-width: 40rem) {
    .wordmark__portrait {
      flex-basis: 2.4rem;
      width: 2.4rem;
      height: 3rem;
    }

    .wordmark__portrait img {
      height: 7.8rem;
    }

    nav {
      overflow-x: visible;
    }

    nav ul {
      width: auto;
      flex-wrap: wrap;
      gap: 0.75rem 1.1rem;
    }

    nav a {
      font-size: 0.78rem;
    }
  }
</style>
