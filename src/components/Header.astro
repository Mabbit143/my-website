---
const nav = [
  { href: '/articles/', label: 'Articles' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="wordmark" aria-label="Deconstructing Academia — home">
      Deconstructing<br /><span>Academia</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 3px solid var(--da-black);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .wordmark {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .wordmark span {
    color: var(--da-pink);
  }

  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  nav a {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 3px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    border-bottom-color: var(--da-chartreuse);
  }
</style>
