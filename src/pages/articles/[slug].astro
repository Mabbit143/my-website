---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SeriesPill from '../../components/SeriesPill.astro';
import { getSeries } from '../../lib/series';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const related = allArticles
  .filter((a) => a.slug !== entry.slug && a.data.series === entry.data.series)
  .slice(0, 2);

const dateStr = entry.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={entry.data.title} description={entry.data.description} ogImage={entry.data.socialImage}>
  <article class="wrap article" data-palette={getSeries(entry.data.series)?.palette}>
    <header class="article-header">
      <SeriesPill slug={entry.data.series} />
      <h1>{entry.data.title}</h1>
      <p class="deck typewriter">{entry.data.deck}</p>
      <p class="byline meta-mono">
        By {entry.data.author} · <time datetime={entry.data.pubDate.toISOString()}>{dateStr}</time>
        {
          entry.data.updatedDate && (
            <>
              {' '}
              · updated{' '}
              <time datetime={entry.data.updatedDate.toISOString()}>
                {entry.data.updatedDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </>
          )
        }
      </p>
      {
        entry.data.placeholder && (
          <p class="placeholder-note">
            <strong>Sample content.</strong> This article exists to demonstrate the template — swap
            it for a real piece before launch. See <code>src/content/articles/_README.md</code>.
          </p>
        )
      }
    </header>

    {
      entry.data.coverImage && (
        <figure class="article-cover">
          <span class="tape" aria-hidden="true" />
          <img
            src={entry.data.coverImage}
            alt={entry.data.coverAlt ?? `${entry.data.title} article graphic`}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
          />
          {entry.data.coverCaption && <figcaption>{entry.data.coverCaption}</figcaption>}
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      related.length > 0 && (
        <aside class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">More from this series</h2>
          <div class="grid">
            {related.map((r) => (
              <ArticleCard entry={r} />
            ))}
          </div>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-4) var(--space-6);
    background: var(--color-bg);
    color: var(--color-fg);
  }

  /* chalkboard series only: the article reads as one big slab sitting on
     the page, matching how ArticleCard/series-card already treat a "clipping"
     — not a full-bleed reskin of the header/footer/rest of the site. */
  .article[data-palette='chalkboard'] {
    border-radius: var(--radius);
    padding-top: var(--space-3);
  }

  .article-header {
    max-width: var(--content-max);
    margin-bottom: var(--space-4);
  }

  .article-header h1 {
    margin-top: var(--space-1);
  }

  .deck {
    font-size: var(--step-1);
    max-width: var(--content-max);
  }

  .byline {
    font-size: var(--step--1);
    opacity: 0.75;
  }

  .article-header .placeholder-note {
    margin-top: var(--space-2);
    max-width: var(--content-max);
  }

  .article-cover {
    position: relative;
    width: min(100%, 58rem);
    margin: 0 0 var(--space-4);
    padding: 0.55rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 5px 6px 0 color-mix(in srgb, var(--ink) 16%, transparent);
    transform: rotate(-0.35deg);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    max-height: 38rem;
    object-fit: contain;
    background: color-mix(in srgb, var(--accent-3) 18%, var(--paper));
  }

  .article-cover figcaption {
    padding: 0.7rem 0.4rem 0.2rem;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .prose {
    max-width: var(--content-max);
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--accent-1);
    margin: var(--space-3) 0;
    padding-left: var(--space-2);
    font-family: var(--font-annotation);
    font-size: var(--step-1);
    color: var(--accent-1);
  }

  .prose :global(a) {
    text-decoration-color: var(--accent-2);
  }

  /* Any ordinary Markdown image becomes a designed article graphic.
     A single italic paragraph immediately after it becomes its caption. */
  .prose :global(p:has(> img:only-child)),
  .prose :global(p:has(> a:only-child > img:only-child)) {
    position: relative;
    width: min(100%, 52rem);
    margin: var(--space-4) 0 var(--space-2);
    padding: 0.5rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 5px 0 color-mix(in srgb, var(--ink) 14%, transparent);
    transform: rotate(0.25deg);
  }

  .prose :global(p:has(> img:only-child)::before),
  .prose :global(p:has(> a:only-child > img:only-child)::before) {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 1.5rem;
    width: 4rem;
    height: 1.35rem;
    z-index: 1;
    background: color-mix(in srgb, var(--accent-3) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    box-shadow: 0 2px 3px rgb(0 0 0 / 14%);
    transform: rotate(-4deg);
  }

  .prose :global(p:has(> img:only-child) img),
  .prose :global(p:has(> a:only-child > img:only-child) img) {
    width: 100%;
    height: auto;
    max-height: 38rem;
    object-fit: contain;
    background: color-mix(in srgb, var(--accent-3) 14%, var(--paper));
  }

  .prose :global(p:has(> img:only-child) + p:has(> em:only-child)),
  .prose :global(p:has(> a:only-child > img:only-child) + p:has(> em:only-child)) {
    margin-top: 0;
    color: color-mix(in srgb, var(--color-fg) 72%, transparent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .related {
    border-top: 3px solid var(--ink);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    max-width: var(--page-max);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .article-cover,
    .prose :global(p:has(> img:only-child)),
    .prose :global(p:has(> a:only-child > img:only-child)) {
      transform: none;
      box-shadow: 3px 4px 0 color-mix(in srgb, var(--ink) 14%, transparent);
    }
  }
</style>
