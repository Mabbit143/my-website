---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SERIES } from '../../lib/series';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Articles"
  description="Browse everything Deconstructing Academia has published, filterable by series."
>
  <section class="wrap archive-hero" data-palette="archive">
    <span class="splat splat--violet archive-hero__s1" aria-hidden="true"></span>
    <span class="splat splat--lime archive-hero__s2" aria-hidden="true"></span>
    <div class="archive-hero__copy">
      <p class="eyebrow">The evidence wall · {allArticles.length} dispatches filed</p>
      <h1 class="strip-stack">
        <span class="strip strip--paper torn-lr">Every file</span>
        <span class="strip strip--lime torn-lr">has a drawer.</span>
      </h1>
      <p class="scribble archive-hero__scribble">pick one. pull.</p>
      <p class="archive-hero__deck">
        Eight questions, multiple ways into the machinery. Filter by the argument you need—or start
        pulling threads and see what comes loose.
      </p>
      <p class="archive-hero__annotation">No velvet rope. No database login. Just the work.</p>
    </div>
    <div class="archive-hero__character" aria-hidden="true">
      <img src="/images/characters/Whonah-laying-eyes-forwards.png" alt="" width="1376" height="768" />
    </div>
  </section>

  <section class="wrap filter-desk" aria-labelledby="filter-heading">
    <div class="filter-desk__label">
      <span>Eight ways in</span>
      <h2 id="filter-heading">Choose a series</h2>
    </div>
    <div class="filters" aria-label="Filter by series">
    <button type="button" class="filter-btn is-active" data-series="all">All</button>
    {
      SERIES.map((s) => (
        <button type="button" class="filter-btn" data-palette={s.palette} data-series={s.slug}>
          {s.name}
        </button>
      ))
    }
    </div>
  </section>

  <section class="wrap archive-results" aria-live="polite">
    {
      allArticles.length === 0 ? (
        <p class="placeholder-note">
          <strong>No articles yet.</strong> Add Markdown files to{' '}
          <code>src/content/articles/</code> — see the README in that folder.
        </p>
      ) : (
        <div class="grid" id="article-grid">
          {allArticles.map((entry) => (
            <div class="grid-item" data-series={entry.data.series}>
              <ArticleCard entry={entry} />
            </div>
          ))}
        </div>
      )
    }
    <p id="no-results" class="placeholder-note" hidden>
      No articles in this series yet.
    </p>
  </section>
</BaseLayout>

<style>
  .archive-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    align-items: end;
    min-height: 31rem;
    padding-block: var(--space-5) 0;
  }

  .archive-hero > :not(.splat) { position: relative; z-index: 1; }
  .archive-hero__s1 { right: -16rem; top: -12rem; width: 46rem; height: 46rem; }
  .archive-hero__s2 { right: 4rem; top: 10rem; width: 20rem; height: 20rem; }

  .archive-hero__copy { align-self: center; padding-bottom: var(--space-5); }
  .archive-hero__scribble { margin: 0.4rem 0 0 clamp(3rem, 18vw, 16rem); }
  .archive-hero__deck { max-width: 34rem; margin-top: var(--space-2); font-size: 1.15rem; line-height: 1.55; }
  .archive-hero__annotation { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--cyan-light); }
  .archive-hero__character { position: relative; min-height: 20rem; }
  .archive-hero__character img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: 100%; object-fit: contain; object-position: center bottom; }

  .filter-desk {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-4) var(--space-3);
  }
  .filter-desk__label span { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); }
  .filter-desk__label h2 { margin-top: 0.35rem; font-size: 2rem; }

  .archive-results { padding-bottom: var(--space-5); }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    border: 2px solid var(--accent-text);
    border-radius: var(--radius);
    background: transparent;
    color: var(--paper);
    padding: 0 1rem;
    cursor: pointer;
  }

  .filter-btn[data-palette]::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    background: var(--accent-1);
  }

  .filter-btn:hover { background: rgb(245 242 234 / 6%); }

  .filter-btn.is-active {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-5) var(--space-4);
    padding-block: var(--space-3) var(--space-5);
  }

  @media (max-width: 52rem) {
    .archive-hero { grid-template-columns: minmax(0, 1fr) 14rem; }
    .filter-desk { grid-template-columns: 1fr; }
  }

  @media (max-width: 40rem) {
    .archive-hero { grid-template-columns: 1fr; padding-top: var(--space-4); }
    .archive-hero__s1 { right: -20rem; top: 16rem; width: 34rem; height: 34rem; }
    .archive-hero__s2 { display: none; }
    .archive-hero__copy { padding-bottom: var(--space-2); }
    .archive-hero__scribble { margin-left: 7rem; }
    .archive-hero__character { min-height: 13rem; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('#article-grid .grid-item');
  const noResults = document.getElementById('no-results');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      const series = btn.dataset.series;
      let visibleCount = 0;

      items.forEach((item) => {
        const match = series === 'all' || item.dataset.series === series;
        item.hidden = !match;
        if (match) visibleCount++;
      });

      if (noResults) noResults.hidden = visibleCount !== 0;

      const url = new URL(window.location.href);
      if (series === 'all') {
        url.searchParams.delete('series');
      } else {
        url.searchParams.set('series', series ?? '');
      }
      window.history.replaceState({}, '', url);
    });
  });

  // Apply ?series= from the URL on load (so links from the homepage series
  // explorer land pre-filtered).
  const initial = new URLSearchParams(window.location.search).get('series');
  if (initial) {
    const match = Array.from(buttons).find((b) => b.dataset.series === initial);
    match?.click();
  }
</script>
