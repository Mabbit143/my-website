---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CharacterPanel from '../components/CharacterPanel.astro';
---

<BaseLayout
  title="Shop"
  description="Practical Deconstructing Academia tools for finding the rules before the rules find your grade."
>
  <section class="wrap shop-hero" data-palette="field-notes">
    <span class="splat splat--violet shop-hero__s1" aria-hidden="true"></span>
    <span class="splat splat--lime shop-hero__s2" aria-hidden="true"></span>
    <p class="eyebrow">Tools, not motivational wallpaper</p>
    <h1 class="strip-stack">
      <span class="strip strip--paper torn-lr">Find the rule.</span>
      <span class="strip strip--lime torn-lr">Keep the receipt.</span>
    </h1>
    <p class="scribble shop-hero__scribble">fillable, too</p>
    <p class="shop-hero__deck">
      Downloadable tools for students who need the actual policy, the actual math, and the actual
      next move—not another lecture about trying harder.
    </p>
  </section>

  <section class="wrap products" aria-labelledby="products-heading">
    <h2 id="products-heading" class="visually-hidden">Available tools</h2>
    <ProductCard
      eyebrow="Available now · instant download"
      title="The Syllabus Audit Kit + Grade Tracker"
      description="A rule-by-rule worksheet for decoding what the syllabus says, what it leaves vague, and what those choices can do to your grade."
      price="$7"
      href="https://www.etsy.com/listing/4568126568/syllabus-audit-kit-grade-tracker"
      cta="Get it on Etsy"
      bullets={[
        'Audit attendance, late-work, participation, and grading rules',
        'Track where your grade actually stands',
        'Keep the unanswered questions visible before they become penalties',
      ]}
    />
    <ProductCard
      eyebrow="Now on Etsy · instant download"
      title="The Curriculum Bias Audit Kit"
      description="A worksheet for reading a syllabus, reading list, or course pack the way you'd read a source: whose names show up, whose don't, and what that pattern is quietly teaching you about who counts as an expert."
      price="$9"
      href="https://deconstructacademia.etsy.com"
      cta="Get it on Etsy"
      bullets={[
        "Map who's actually on the reading list — by discipline, era, and perspective",
        "Spot the gaps before a professor calls them \"balance\"",
        'Turn the pattern into a specific, answerable question you can actually ask',
      ]}
    />
  </section>

  <section class="wrap shop-guide">
    <CharacterPanel
      compact
      eyebrow="The field-test rule"
      title="A tool should lower the fog."
      body="Mabbit takes the policy apart. Whonah stays on the evidence trail. If a worksheet cannot tell you what to look for or what to do next, it is just prettier homework."
      linkHref="/articles/?series=use-the-damn-tool"
      linkLabel="Read Use the Damn Tool →"
    />
  </section>
</BaseLayout>

<style>
  .shop-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-5) var(--space-4);
  }

  .shop-hero > :not(.splat) {
    position: relative;
    z-index: 1;
  }

  .shop-hero__s1 { right: -14rem; top: -12rem; width: 40rem; height: 40rem; }
  .shop-hero__s2 { right: 12rem; top: 6rem; width: 16rem; height: 16rem; }
  .shop-hero__scribble { margin: 0.4rem 0 0 clamp(3rem, 20vw, 18rem); }

  .shop-hero__deck {
    max-width: 40rem;
    margin-top: var(--space-2);
    font-size: 1.15rem;
    line-height: 1.55;
  }

  @media (max-width: 40rem) {
    .shop-hero__s1 { right: -22rem; top: -4rem; width: 30rem; height: 30rem; }
    .shop-hero__s2 { display: none; }
  }

  .products {
    display: grid;
    gap: var(--space-5);
  }

  .products,
  .shop-guide {
    padding-block: var(--space-4);
  }
</style>
