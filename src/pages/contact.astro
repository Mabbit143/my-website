---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Deconstructing Academia.">
  <section class="wrap contact-hero" data-palette="field-notes">
    <span class="splat splat--violet contact-hero__s1" aria-hidden="true"></span>
    <span class="splat splat--pink contact-hero__s2" aria-hidden="true"></span>
    <div>
      <p class="eyebrow">Corrections · tips · collaboration</p>
      <h1 class="strip-stack">
        <span class="strip strip--paper torn-lr">Put it</span>
        <span class="strip strip--lime torn-lr">on the record.</span>
      </h1>
      <p class="contact-hero__deck">Reach out about corrections, tips, pitches, speaking, or just to say the argument landed—or didn't.</p>
    </div>
    <div class="contact-hero__art" aria-hidden="true">
      <img src="/images/characters/Whonah-side-view-frisbee=forward.png" alt="" width="1376" height="768" />
    </div>
  </section>

  <section class="wrap contact-routing" aria-label="Reasons to contact Deconstructing Academia">
    <article data-palette="public-record"><span>01</span><h2>Correction</h2><p>Found a factual error, broken source, missing context, or claim that needs another look?</p></article>
    <article data-palette="archive"><span>02</span><h2>Tip or pitch</h2><p>Have a record, pattern, research lead, or story that deserves scrutiny?</p></article>
    <article data-palette="red-pen"><span>03</span><h2>Work together</h2><p>Speaking, research, educational tools, or a collaboration that fits the project?</p></article>
  </section>

  <section class="contact-desk" data-palette="field-notes">
    <div class="wrap contact-grid">
      <aside>
        <p class="contact-grid__label">Before you send</p>
        <h2>Specific beats mysterious.</h2>
        <ul>
          <li>Link the page or source when you can.</li>
          <li>Name the claim or passage you mean.</li>
          <li>Say whether a response is time-sensitive.</li>
        </ul>
        <p class="contact-grid__note">Whonah accepts evidence. He does not accept institutional fog.</p>
      </aside>

      <form class="paper-surface torn-b" action="https://formspree.io/f/xbgjalyg" method="POST">
        <span class="tape" aria-hidden="true"></span>
        <span class="tape tape--right" aria-hidden="true"></span>
        <div class="form-heading">
          <span>Message form</span>
          <h2>Send the receipt.</h2>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="reason">Reason for contact</label>
          <select id="reason" name="reason" required>
            <option value="" disabled selected>Choose one</option>
            <option value="Correction">Correction</option>
            <option value="Tip">Tip</option>
            <option value="Pitch/Collaboration">Pitch / Collaboration</option>
            <option value="General feedback">General feedback</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="8" required></textarea>
        </div>
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_subject" value="New message — Deconstructing Academia contact form" />
        <button type="submit" class="btn">Send the message →</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr); align-items: end; min-height: 31rem; padding-block: var(--space-5) 0; }
  .contact-hero > :not(.splat) { position: relative; z-index: 1; }
  .contact-hero__s1 { right: -16rem; top: -10rem; width: 44rem; height: 44rem; }
  .contact-hero__s2 { right: 10rem; top: 14rem; width: 18rem; height: 18rem; }
  .contact-hero > div:first-of-type { align-self: center; padding-bottom: var(--space-5); }
  .contact-grid__label,.form-heading span { font-family: var(--font-label); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); }
  .contact-hero__deck { max-width: 34rem; margin-top: var(--space-3); font-size: 1.15rem; line-height: 1.55; }
  .contact-hero__art { position: relative; min-height: 23rem; }
  .contact-hero__art img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: 100%; object-fit: contain; object-position: center bottom; }
  .contact-routing { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); padding-block: var(--space-5) var(--space-4); }
  .contact-routing article { min-height: 12rem; padding: var(--space-3); border-top: 6px solid var(--accent-1); background: rgb(13 11 18 / 78%); box-shadow: var(--shadow-card); }
  .contact-routing span { font-family: var(--font-headline); font-size: 3rem; line-height: 0.9; color: var(--accent-text); }
  .contact-routing h2 { margin-top: var(--space-2); font-size: 1.8rem; }
  .contact-routing p { font-size: 1rem; }
  .contact-desk { padding-block: var(--space-4) var(--space-6); }
  .contact-grid { display: grid; grid-template-columns: minmax(14rem, 0.6fr) minmax(0, 1.4fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .contact-grid aside { position: sticky; top: var(--space-3); }
  .contact-grid aside ul { padding-left: 1.2em; }
  .contact-grid__note { margin-top: var(--space-3); font-family: var(--font-annotation); font-weight: 600; font-size: 1.7rem; line-height: 1.15; color: var(--pink); transform: rotate(-3deg); }
  form { position: relative; display: grid; gap: var(--space-2); padding: clamp(1.5rem, 4vw, 2.8rem) clamp(1.2rem, 4vw, 2.8rem) clamp(2rem, 5vw, 3.2rem); box-shadow: var(--shadow-card); transform: rotate(0.6deg); }
  form h2 { color: var(--ink); }
  .form-heading span { color: var(--cyan-dark); }
  .form-heading { border-bottom: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent); }
  .field-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
  .field { display: grid; gap: 0.35em; }
  label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; font-size: var(--step--1); letter-spacing: 0.03em; }
  label { color: var(--ink); }
  input,select,textarea { width: 100%; min-height: 48px; font-family: var(--font-body); font-size: var(--step-0); padding: 0.75em 0.85em; border: 2px solid var(--ink); border-radius: 2px; background: rgb(255 255 255 / 40%); color: var(--ink); }
  form .btn { background: var(--ink); border-color: var(--ink); color: var(--lime); min-height: 48px; }
  form .btn:hover { background: transparent; color: var(--ink); }
  input:focus,select:focus,textarea:focus { border-color: var(--pink-dark); }
  form :focus-visible { outline-color: var(--ink) !important; }
  textarea { resize: vertical; }
  button { justify-self: start; }
  @media (max-width: 48rem) {
    .contact-hero { grid-template-columns: minmax(0, 1fr) 13rem; }
    .contact-grid { grid-template-columns: 1fr; }
    .contact-grid aside { position: static; }
  }
  @media (max-width: 40rem) {
    .contact-hero { grid-template-columns: 1fr; min-height: 0; }
    .contact-hero > div:first-of-type { padding-bottom: var(--space-2); }
    .contact-hero h1 { font-size: 3rem; }
    .contact-hero__art { min-height: 14rem; }
    .contact-routing,.field-row { grid-template-columns: 1fr; }
    .contact-routing article { min-height: auto; }
    form { transform: none; }
    .contact-hero__s1 { right: -20rem; top: 12rem; width: 32rem; height: 32rem; }
    .contact-hero__s2 { display: none; }
  }
</style>
