---
import BaseLayout from '../layouts/BaseLayout.astro';
import Splatter from '../components/Splatter.astro';
---

<BaseLayout title="Contact" description="Get in touch with Deconstructing Academia.">
  <section class="wrap contact-hero" data-palette="field-notes">
    <span class="contact-hero__splat" aria-hidden="true"><Splatter variant="burst" /></span>
    <div>
      <p class="contact-hero__eyebrow">Corrections · tips · collaboration</p>
      <h1><span>Put it</span><strong>on the record.</strong></h1>
      <p class="contact-hero__deck">Reach out about corrections, tips, pitches, speaking, or just to say the argument landed—or didn't.</p>
    </div>
    <div class="contact-hero__art" aria-hidden="true">
      <img src="/images/characters/Whonah-side-view-frisbee=forward.png" alt="" width="1376" height="768" />
    </div>
  </section>

  <section class="wrap contact-routing" aria-label="Reasons to contact Deconstructing Academia">
    <article data-palette="public-record"><span>01</span><h2>Correction</h2><p>Found a factual error, broken source, missing context, or claim that needs another look?</p></article>
    <article data-palette="archive"><span>02</span><h2>Tip or pitch</h2><p>Have a record, pattern, research lead, or story that deserves scrutiny?</p></article>
    <article data-palette="red-pen"><span>03</span><h2>Work together</h2><p>Speaking, research, educational tools, or a collaboration that fits the project?</p></article>
  </section>

  <section class="contact-desk" data-palette="field-notes">
    <div class="wrap contact-grid">
      <aside>
        <p class="contact-grid__label">Before you send</p>
        <h2>Specific beats mysterious.</h2>
        <ul>
          <li>Link the page or source when you can.</li>
          <li>Name the claim or passage you mean.</li>
          <li>Say whether a response is time-sensitive.</li>
        </ul>
        <p class="contact-grid__note">Whonah accepts evidence. He does not accept institutional fog.</p>
      </aside>

      <form action="https://formspree.io/f/xbgjalyg" method="POST">
        <div class="form-heading">
          <span>Message form</span>
          <h2>Send the receipt.</h2>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
        </div>
        <div class="field">
          <label for="reason">Reason for contact</label>
          <select id="reason" name="reason" required>
            <option value="" disabled selected>Choose one</option>
            <option value="Correction">Correction</option>
            <option value="Tip">Tip</option>
            <option value="Pitch/Collaboration">Pitch / Collaboration</option>
            <option value="General feedback">General feedback</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="8" required></textarea>
        </div>
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="_subject" value="New message — Deconstructing Academia contact form" />
        <button type="submit" class="btn">Send the message →</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr); align-items: end; min-height: 31rem; padding-block: var(--space-5) 0; }
  .contact-hero__splat { position: absolute; z-index: -1; left: -8rem; top: -10rem; width: 30rem; color: var(--accent-1); opacity: 0.2; }
  .contact-hero > div:first-of-type { align-self: center; padding-bottom: var(--space-5); }
  .contact-hero__eyebrow,.contact-grid__label,.form-heading span { font-family: var(--font-mono); font-size: var(--step--1); font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent-1); }
  .contact-hero h1 { display: grid; justify-items: start; gap: 0.12em; margin-block: var(--space-2); font-size: var(--step-5); }
  .contact-hero h1 span,.contact-hero h1 strong { padding: 0.05em 0.14em; color: var(--ink); font-weight: 400; line-height: 0.94; box-shadow: 7px 7px 0 rgb(0 0 0 / 48%); }
  .contact-hero h1 span { background: var(--paper); transform: rotate(-1deg); }
  .contact-hero h1 strong { background: var(--accent-1); transform: rotate(0.7deg); }
  .contact-hero__deck { font-family: var(--font-typewriter); font-size: var(--step-1); }
  .contact-hero__art { position: relative; min-height: 23rem; overflow: hidden; }
  .contact-hero__art img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: 100%; object-fit: contain; object-position: center bottom; filter: drop-shadow(8px 7px 0 rgb(0 0 0 / 55%)); }
  .contact-routing { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding-block: var(--space-4); }
  .contact-routing article { min-height: 12rem; padding: var(--space-3); border-top: 7px solid var(--accent-1); background: color-mix(in srgb, var(--ink) 94%, white); }
  .contact-routing span { font-family: var(--font-mono); color: var(--accent-1); }
  .contact-routing h2 { margin-top: var(--space-2); font-size: var(--step-2); }
  .contact-routing p { font-family: var(--font-typewriter); font-size: var(--step--1); }
  .contact-desk { padding-block: var(--space-5) var(--space-6); background: var(--paper); color: var(--ink); }
  .contact-grid { display: grid; grid-template-columns: minmax(14rem, 0.6fr) minmax(0, 1.4fr); gap: clamp(2rem, 7vw, 6rem); align-items: start; }
  .contact-grid aside { position: sticky; top: var(--space-3); }
  .contact-grid aside ul { padding-left: 1.2em; }
  .contact-grid__note { margin-top: var(--space-3); padding: var(--space-2); background: var(--accent-3); font-family: var(--font-annotation); font-size: var(--step-1); line-height: 1.15; transform: rotate(-2deg); box-shadow: 5px 5px 0 rgb(0 0 0 / 20%); }
  form { display: grid; gap: var(--space-2); padding: clamp(1rem, 4vw, 2.5rem); border: 3px solid var(--ink); border-top: 10px solid var(--accent-1); background: #fff; box-shadow: 9px 10px 0 var(--ink); }
  .form-heading { border-bottom: 2px dashed color-mix(in srgb, var(--ink) 25%, transparent); }
  .field-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-2); }
  .field { display: grid; gap: 0.35em; }
  label { font-family: var(--font-label); font-weight: 700; text-transform: uppercase; font-size: var(--step--1); letter-spacing: 0.03em; }
  input,select,textarea { width: 100%; font-family: var(--font-body); font-size: var(--step-0); padding: 0.75em 0.85em; border: 2px solid var(--ink); border-radius: 0; background: var(--paper); color: var(--ink); }
  input:focus,select:focus,textarea:focus { border-color: var(--accent-1); }
  textarea { resize: vertical; }
  button { justify-self: start; }
  @media (max-width: 48rem) {
    .contact-hero { grid-template-columns: minmax(0, 1fr) 13rem; }
    .contact-grid { grid-template-columns: 1fr; }
    .contact-grid aside { position: static; }
  }
  @media (max-width: 40rem) {
    .contact-hero { grid-template-columns: 1fr; min-height: 0; }
    .contact-hero > div:first-of-type { padding-bottom: var(--space-2); }
    .contact-hero h1 { font-size: 3rem; }
    .contact-hero__art { min-height: 14rem; }
    .contact-routing,.field-row { grid-template-columns: 1fr; }
    .contact-routing article { min-height: auto; }
    form { box-shadow: 5px 6px 0 var(--ink); }
  }
</style>
