---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmailSignup from '../components/EmailSignup.astro';
import PageMarkFeature from '../components/PageMarkFeature.astro';
import { SERIES } from '../lib/series';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = allArticles[0];
const latest = allArticles.slice(1, 3);
const countBySeries = (slug: string) => allArticles.filter((a) => a.data.series === slug).length;

// Same two kits and prices as src/pages/shop.astro — keep them in sync.
const kits = [
  {
    no: 'No. 01',
    title: 'The Syllabus Audit Kit + Grade Tracker',
    body: 'Decode the fine print, surface the unanswered questions, and calculate where your grade actually stands.',
    price: '$7',
    href: 'https://www.etsy.com/listing/4568126568/syllabus-audit-kit-grade-tracker',
  },
  {
    no: 'No. 02',
    title: 'The Curriculum Bias Audit Kit',
    body: "Read a reading list the way you'd read a source: whose names show up, whose don't, and what that pattern teaches.",
    price: '$9',
    href: 'https://deconstructacademia.etsy.com',
  },
];
---

<BaseLayout
  title="Deconstructing Academia"
  description="A critical academic-literacy publication. Learn the rules. Question who wrote them."
>
  <section class="hero">
    <span class="splat splat--violet hero__s1" aria-hidden="true"></span>
    <span class="splat splat--lime hero__s2" aria-hidden="true"></span>
    <span class="splat splat--pink hero__s3" aria-hidden="true"></span>
    <span class="splat splat--cyan hero__s4" aria-hidden="true"></span>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Academic literacy for people academia expected to figure it out alone</p>
        <h1 class="strip-stack">
          <span class="strip strip--paper torn-lr">Learn the rules.</span>
          <span class="strip strip--paper torn-lr">Question who</span>
          <span class="strip strip--lime torn-lr">wrote them.</span>
        </h1>
        <p class="scribble hero__scribble">yes, all of them.</p>
        <p class="hero__deck">
          We take apart hidden rules, trace the evidence, and build tools you can actually use.
          Prestige does not get to grade its own homework here.
        </p>
        <div class="hero__actions">
          <a href="#start-here" class="btn hero__btn">Start reading</a>
          <a href="/shop/" class="btn btn--ghost">Grab a toolkit</a>
        </div>
      </div>
      <div class="hero__characters">
        <img
          class="hero__mabbit"
          src="/images/characters/Mabbit-front-arms-crossed-cropped.png"
          alt="Mabbit, the tattooed rabbit character with purple hair, standing with arms crossed"
          width="235"
          height="745"
          loading="eager"
          decoding="async"
        />
        <img
          class="hero__whonah"
          src="/images/characters/Whonah-sitting-forward.png"
          alt="Whonah, a German Shepherd in a green harness, sitting beside Mabbit"
          width="256"
          height="470"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <PageMarkFeature articleHref="/articles/i-built-an-app-that-types-up-my-handwritten-notes/" />

  {
    featured && (
      <section id="start-here" class="wrap fresh" aria-labelledby="fresh-heading">
        <header class="fresh__head">
          <h2 id="fresh-heading" class="section-title">Fresh off the photocopier</h2>
          <span class="scribble">still warm</span>
        </header>
        <div class="fresh__grid">
          <div class="fresh__lead">
            <ArticleCard entry={featured} featured />
          </div>
          <div class="fresh__side">
            {latest.map((entry) => <ArticleCard entry={entry} />)}
            <a class="fresh__all" href="/articles/">Open the full archive →</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap drawers" aria-labelledby="drawers-heading">
    <span class="splat splat--cyan drawers__splat" aria-hidden="true"></span>
    <div class="drawers__intro">
      <p class="eyebrow">The series index</p>
      <h2 id="drawers-heading" class="section-title">Every file has a drawer</h2>
      <p>Each article lives in one series, so you can follow a thread instead of a feed.</p>
    </div>
    <ul class="ledger">
      {SERIES.map((series, index) => (
        <li data-palette={series.palette}>
          <a href={`/articles/?series=${series.slug}`}>
            <span class="ledger__num">§ {String(index + 1).padStart(2, '0')}</span>
            <span class="ledger__name">{series.name}</span>
            <span class="ledger__desc">{series.description}</span>
            <span class="ledger__go">
              {countBySeries(series.slug)} {countBySeries(series.slug) === 1 ? 'file' : 'files'} →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap kits" aria-labelledby="kits-heading">
    <header class="fresh__head">
      <h2 id="kits-heading" class="section-title">Tools you can print tonight</h2>
      <span class="scribble">fillable, too</span>
    </header>
    <div class="kits__grid">
      {kits.map((kit) => (
        <article class="kit paper-surface torn-b">
          <span class="tape" aria-hidden="true"></span>
          <p class="kit__meta"><span>Toolkit {kit.no}</span><span class="kit__price">{kit.price}</span></p>
          <h3>{kit.title}</h3>
          <p>{kit.body}</p>
          <a href={kit.href}>Get the kit →</a>
        </article>
      ))}
    </div>
    <p class="kits__fine">Checkout happens on Etsy. <a href="/shop/">See everything in the shop →</a></p>
  </section>

  <section class="band-violet manifesto">
    <span class="splat splat--pink manifesto__splat" aria-hidden="true"></span>
    <div class="wrap manifesto__inner">
      <h2 class="manifesto__line">Not here to make the gate prettier.</h2>
      <div class="manifesto__copy">
        <p>
          Mabbit Rountree is a nontraditional student and freelance researcher who learned
          academia's hidden rules the expensive way, then started writing them down. Whonah is here
          because every evidence trail deserves a German Shepherd.
        </p>
        <div class="hero__actions">
          <a href="/about/" class="btn">About Mabbit</a>
          <a href="/contact/" class="btn btn--ghost">Say hi</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap signup-wrap">
    <EmailSignup />
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__s1 { width: 62rem; height: 62rem; right: -18rem; top: -8rem; }
  .hero__s2 { width: 32rem; height: 32rem; right: -4rem; top: 20rem; }
  .hero__s3 { width: 24rem; height: 24rem; right: 20rem; top: 28rem; }
  .hero__s4 { width: 20rem; height: 20rem; right: 2rem; top: -2rem; }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: var(--space-3);
    align-items: end;
    min-height: 46rem;
    padding-top: var(--space-5);
  }

  .hero__copy {
    align-self: center;
    padding-bottom: var(--space-5);
  }

  .hero__scribble { margin: 0.4rem 0 0 clamp(4rem, 22vw, 20rem); }

  .hero__deck {
    margin-top: var(--space-2);
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: var(--space-3);
  }

  .hero__btn {
    background: var(--lime);
    border-color: var(--lime);
  }

  .hero__btn:hover { color: var(--lime); }

  .btn { min-height: 48px; display: inline-flex; align-items: center; }

  .hero__characters {
    position: relative;
    height: 44rem;
  }

  .hero__mabbit {
    position: absolute;
    left: 0;
    bottom: 0;
    width: auto;
    max-width: none;
    height: 42rem;
  }

  .hero__whonah {
    position: absolute;
    left: 10rem;
    bottom: 0;
    width: auto;
    height: 23rem;
  }

  .fresh { padding-block: var(--space-5) var(--space-4); }

  .fresh__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.4rem 1.4rem;
    margin-bottom: var(--space-4);
  }

  .fresh__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .fresh__side {
    display: grid;
    gap: var(--space-4);
  }

  .fresh__all,
  .kits__fine a {
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
    text-decoration: none;
  }

  .drawers {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(14rem, 0.32fr) minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
  }

  .drawers > :not(.splat) { position: relative; z-index: 1; }
  .drawers__splat { left: -24rem; top: -3rem; width: 30rem; height: 30rem; opacity: 0.75; }
  .drawers__intro .section-title { margin-bottom: var(--space-2); }
  .drawers__intro p:last-child { font-size: 1.05rem; }

  .kits { padding-block: var(--space-4) var(--space-5); }

  .kits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .kit {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 2rem 1.9rem 2.2rem;
    box-shadow: var(--shadow-card);
    transform: rotate(-1deg);
  }

  .kit:nth-child(2) { transform: rotate(0.8deg); }
  .kit h3 {
    margin: 0;
    font-family: var(--font-headline);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.02;
    text-transform: uppercase;
  }
  .kit p { margin: 0; }

  .kit__meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .kit__price { font-weight: 700; font-size: 1rem; }

  .kit a {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink-dark);
    text-decoration: none;
  }

  .kits__fine {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .manifesto { margin-top: var(--space-4); }
  .manifesto__splat { right: -10rem; top: -10rem; width: 28rem; height: 28rem; }

  .manifesto__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-5);
  }

  .manifesto__line {
    margin: 0;
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 4.4rem);
    line-height: 0.98;
  }

  .manifesto__copy p { font-size: 1.05rem; }

  .signup-wrap { padding-block: var(--space-5) 0; }

  @media (max-width: 60rem) {
    .hero__inner { grid-template-columns: minmax(0, 1fr) 15rem; min-height: 38rem; }
    .hero__characters { height: 34rem; }
    .hero__mabbit { height: 32rem; left: 0; }
    .hero__whonah { left: 6.5rem; height: 17rem; }
    .fresh__grid,
    .drawers,
    .manifesto__inner { grid-template-columns: 1fr; }
    .drawers { gap: var(--space-3); }
  }

  @media (max-width: 40rem) {
    .hero__s1 { width: 34rem; height: 34rem; right: -12rem; top: 40rem; }
    .hero__s2 { width: 18rem; height: 18rem; right: -3rem; top: 46rem; }
    .hero__s3 { width: 14rem; height: 14rem; right: 13rem; top: 52rem; }
    .hero__s4 { display: none; }
    .hero__inner { grid-template-columns: 1fr; padding-top: var(--space-4); min-height: 0; }
    .hero__copy { padding-bottom: 0; }
    .hero__scribble { margin-left: 8rem; }
    .hero__actions { display: grid; }
    .hero__actions .btn { justify-content: center; }
    .hero__characters { height: 27rem; }
    .hero__mabbit { height: 26rem; left: 1rem; }
    .hero__whonah { left: 9rem; height: 14rem; }
    .kits__grid { grid-template-columns: 1fr; }
    .manifesto__splat { right: -17rem; top: -15rem; }
  }
</style>
